[
    {
        "id": "file",
        "children": [
            {
                "caption": "-",
                "id": "open"
            },
            {
                "caption": "New Calculation",
                "command": "subcalc_new"
            }
        ]
    },
    {
        "id": "preferences",
        "children": [
            {
                "id": "package-settings",
                "children": [
                    {
                        "caption": "SubCalc",
                        "children": [
                            {
                                "caption": "Settings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/SubCalc/Calc.sublime-settings",
                                    "default": "// Settings in here override those in \"Calc.sublime-settings\",\n// and are added to your \"User\" folder to persist across upgrades.\n{\n\t$0\n}\n"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    },
    {
        "id": "edit",
        "children": [
            {
                "caption": "SubCalc",
                "id": "subcalc",
                "children": [
                    {
                        "caption": "Copy All Results",
                        "command": "subcalc_copy_all_results"
                    },
                    {
                        "caption": "Copy Last Result",
                        "command": "subcalc_copy_last_result"
                    },
                    {
                        "caption": "-"
                    },
                    {
                        "caption": "Toggle Results",
                        "command": "subcalc_toggle_results"
                    },
                    {
                        "caption": "-"
                    },
                    {
                        "caption": "Refresh Currency Rates",
                        "command": "subcalc_refresh_currency_rates"
                    }
                ]
            }
        ]
    }
]
